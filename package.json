{
  "name": "figma-plugin-html-to-figma",
  "version": "0.1.0",
  "description": "Figma plugin to generate Design System components from HTML/React code",
  "repository": {
    "type": "git",
    "url": "https://github.com/eduard-izgorodin-reluna/figma-plugin-html-to-figma.git"
  },
  "private": true,
  "main": "dist/code.js",
  "scripts": {
    "dev": "webpack --mode=development --watch",
    "build": "webpack --mode=production",
    "typecheck": "tsc --noEmit",
    "capture": "tsx scripts/capture-storybook.ts",
    "capture:ds": "tsx scripts/capture-all-ds.ts",
    "capture:button": "tsx scripts/capture-storybook.ts --story button--primary"
  },
  "devDependencies": {
    "@builder.io/html-to-figma": "^0.0.3",
    "@figma/plugin-typings": "^1.98.0",
    "copy-webpack-plugin": "^12.0.2",
    "puppeteer": "^24.31.0",
    "ts-loader": "^9.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.4.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "keywords": [
    "figma",
    "plugin",
    "design-system",
    "react-figma"
  ],
  "author": "Reluna Family",
  "license": "MIT"
}
